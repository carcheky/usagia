{
  "name": "usagia",
  "productName": "Usagia",
  "version": "0.1.0",
  "description": "App de bandeja para ver el uso actual de las IAs configuradas (Minimax, Claude, Antigravity, DeepSeek...) al pasar el ratón por el icono.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/run.js",
    "dev": "node scripts/run.js --verbose",
    "probe": "node scripts/run.js --probe",
    "preview": "node scripts/run.js --preview",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.usagia.tray",
    "productName": "Usagia",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
