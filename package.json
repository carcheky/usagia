{
  "name": "usagia",
  "productName": "Usagia",
  "version": "0.0.0",
  "description": "App de bandeja para ver el uso actual de las IAs configuradas (Minimax, Claude, Antigravity, DeepSeek...) al pasar el ratón por el icono.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "carcheky",
    "email": "carcheky@users.noreply.github.com"
  },
  "desktopName": "usagia",
  "repository": {
    "type": "git",
    "url": "https://github.com/carcheky/usagia.git"
  },
  "homepage": "https://github.com/carcheky/usagia",
  "bugs": {
    "url": "https://github.com/carcheky/usagia/issues"
  },
  "scripts": {
    "start": "node scripts/run.js",
    "dev": "node scripts/run.js --verbose",
    "probe": "node scripts/probe.js",
    "preview": "node scripts/run.js --preview --in-process-gpu",
    "preview:settings": "node scripts/run.js --settings --in-process-gpu",
    "lint": "eslint .",
    "test": "node scripts/test.js",
    "test:package": "node scripts/test-package.js",
    "test:ci-env": "node scripts/test-probe-clean-env.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release:dry": "node scripts/release.js --dry-run"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0"
  },
  "build": {
    "appId": "com.usagia.tray",
    "productName": "Usagia",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "scripts/*.ps1",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/*.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons",
      "category": "Utility",
      "synopsis": "Uso actual de tus IAs en la bandeja del sistema",
      "description": "App de bandeja que muestra el consumo actual de las IAs configuradas (Minimax, Claude, Antigravity, DeepSeek) al pasar el raton por el icono.",
      "syncDesktopName": true
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-portable-${version}-${os}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    }
  }
}
