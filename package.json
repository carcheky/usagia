{
  "name": "usagia",
  "productName": "Usagia",
  "version": "0.0.0",
  "description": "App de bandeja para ver el uso actual de las IAs configuradas (Minimax, Claude, Antigravity, DeepSeek...) al pasar el ratón por el icono.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "author": "carcheky",
  "repository": {
    "type": "git",
    "url": "https://github.com/carcheky/usagia.git"
  },
  "homepage": "https://github.com/carcheky/usagia",
  "bugs": {
    "url": "https://github.com/carcheky/usagia/issues"
  },
  "scripts": {
    "start": "node scripts/run.js",
    "dev": "node scripts/run.js --verbose",
    "probe": "node scripts/run.js --probe",
    "preview": "node scripts/run.js --preview",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release:dry": "npx --yes semantic-release@25 --dry-run"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.usagia.tray",
    "productName": "Usagia",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Uso actual de tus IAs en la bandeja del sistema",
      "description": "App de bandeja que muestra el consumo actual de las IAs configuradas (Minimax, Claude, Antigravity, DeepSeek) al pasar el raton por el icono."
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-portable-${version}-${os}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    }
  }
}
